# ============================================================
# MadHatter Comedy Club — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it's already in .gitignore).

# --- Authentication ---
NEXTAUTH_SECRET=          # Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
MEMBER_JWT_SECRET=        # Generate with: openssl rand -base64 32 (optional, falls back to NEXTAUTH_SECRET)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Membership Payments) ---
STRIPE_SECRET_KEY=        # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=    # whsec_...
STRIPE_MAD_MEMBER_MONTHLY_PRICE_ID=
STRIPE_MAD_MEMBER_ANNUAL_PRICE_ID=
STRIPE_TOP_HAT_MONTHLY_PRICE_ID=
STRIPE_TOP_HAT_ANNUAL_PRICE_ID=

# --- Square (Ticket/Merch/Gift Card Payments) ---
SQUARE_ACCESS_TOKEN=      # Your Square access token
SQUARE_ENVIRONMENT=sandbox  # "sandbox" or "production"
SQUARE_LOCATION_ID=       # Your Square location ID
SQUARE_WEBHOOK_SIGNATURE_KEY=  # From Square Developer Dashboard
SQUARE_WEBHOOK_URL=       # e.g., https://yourdomain.com/api/webhooks/square

# --- Resend (Email Notifications) ---
RESEND_API_KEY=           # re_...
NOTIFICATION_FROM_EMAIL=Mad Hatter <notifications@madhattercomedy.com>
ADMIN_NOTIFICATION_EMAIL=hello@madhattercomedy.com

# --- Upstash Redis (Rate Limiting) ---
# Free tier: 500k commands/month. Do NOT add a credit card to avoid charges.
UPSTASH_REDIS_REST_URL=   # https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN= # Your Upstash REST token

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=  # Google Analytics (optional)

# --- Legacy (can be removed if not using seed scripts) ---
SITE_PASSWORD=
